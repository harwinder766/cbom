# ==============================================================================
# Enterprise Cryptographic Discovery & Analysis Tool (ECDAT) - Environment Config
# ==============================================================================

# Port the backend server listens on (Render automatically supplies $PORT; default 8000)
PORT=8000

# Host network interface to bind (0.0.0.0 binds all interfaces for Docker and cloud)
HOST=0.0.0.0

# Comma-separated list of allowed frontend origins for CORS (e.g., http://localhost:3000,https://cbom.vercel.app)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database connection URL (SQLite or PostgreSQL; e.g., sqlite:///./cbom.db or postgresql://user:pass@host/db)
DATABASE_URL=sqlite:///./cbom.db

# Filesystem directory for temporary user uploads (stored outside watched project dirs to prevent dev reload restarts)
UPLOAD_DIR=/tmp/cbom_uploads

# Filesystem directory for sandbox workspaces and shallow git clones
WORKSPACE_DIR=/tmp/cbom_workspaces

# Directory path containing knowledge base JSON files (algorithms, recommendations, CycloneDX schema)
DATA_DIR=./data

# Enable or disable local path scanning (set to false on Render/cloud to reject local path scans)
ALLOW_LOCAL_SCANS=true

# Development mode flag (bypasses directory allowlist checks when local scans are enabled)
DEV_MODE=true

# Comma-separated list of allowlisted safe directory paths for local scanning when DEV_MODE=false
ALLOWLISTED_ROOTS=

# Maximum upload payload size in bytes (104857600 bytes = 100 MB)
MAX_UPLOAD_SIZE_BYTES=104857600

# Maximum cloned git repository size on disk in bytes (262144000 bytes = 250 MB)
MAX_REPO_CLONE_SIZE_BYTES=262144000

# Maximum execution timeout for a scan pipeline in seconds before marking it failed (300 seconds = 5 minutes)
SCAN_TIMEOUT_SECONDS=300

# Maximum number of concurrent active scans (queued or running) allowed before returning 429 Busy
MAX_CONCURRENT_SCANS=3

# Maximum total extracted uncompressed size for zip archives in bytes (250 MB)
MAX_ZIP_EXTRACTED_SIZE_BYTES=262144000

# Maximum number of files permitted inside an uploaded zip archive (prevents zip bomb attacks)
MAX_ZIP_FILE_COUNT=10000

# Default Mosca post-quantum timeline parameters (X + Y > Z)
# Estimated years until Cryptographically Relevant Quantum Computer (Z in Mosca inequality)
DEFAULT_CRQC_YEARS=12

# Default shelf-life years data must remain confidential (X in Mosca inequality)
DEFAULT_SHELF_LIFE_YEARS=10

# Default migration time required to transition systems to PQC (Y in Mosca inequality)
DEFAULT_MIGRATION_TIME_YEARS=5
